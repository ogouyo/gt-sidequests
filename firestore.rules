rules_version = '2';
// GT Sidequests security rules. Paste into Firebase console > Firestore > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isHost() {
      return signedIn()
        && request.auth.token.email == 'ejimahshalom@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function cfg() { return get(/databases/$(database)/documents/config/game).data; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function symDiff(a, b) { return a.toSet().difference(b.toSet()).union(b.toSet().difference(a.toSet())); }
    function validName(n) { return n is string && n.size() >= 2 && n.size() <= 20; }
    function isPlayer() { return signedIn() && exists(/databases/$(database)/documents/players/$(me())); }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isHost();
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'createdAt', 'adjust'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.adjust == 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isHost();
    }

    // One doc per lowercase name, so names stay unique.
    match /names/{nameLower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'key'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/players/$(me())).data.nameLower == nameLower;
      // A player who signed up before PINs existed may add their PIN key once.
      allow update: if isHost() || (signedIn()
        && resource.data.uid == me()
        && !('key' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['key']));
      allow delete: if isHost();
    }

    // "That's me on a new phone" requests, approved by the host.
    match /claims/{uid} {
      allow read: if isHost() || (signedIn() && me() == uid);
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.createdAt == request.time;
      allow delete: if isHost() || (signedIn() && me() == uid);
      allow update: if isHost();
    }

    // Sidequests sent to the host.
    match /inbox/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'createdAt', 'status'])
        && (request.resource.data.fromUid == null || request.resource.data.fromUid == me())
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isHost();
    }

    match /quests/{qid} {
      allow read: if signedIn();
      allow create: if isHost() || suggestQuest();
      allow delete: if isHost();
      allow update: if isHost() || joinQuest() || leaveQuest() || setStatus() || toggleTwist();

      // Players can publish their own (easy, bonus) quest ideas straight to the board.
      function suggestQuest() {
        let n = request.resource.data;
        return isPlayer()
          && n.keys().hasOnly(['title', 'blurb', 'type', 'pool', 'level', 'category', 'min', 'max', 'instructions', 'doneWhen',
                               'twistCount', 'needsHostSetup', 'order', 'active', 'members', 'twistDone', 'status', 'note',
                               'completedBy', 'completedAt', 'suggestedBy'])
          && n.suggestedBy == me()
          && str(n.title, 2, 40) && str(n.blurb, 0, 300) && str(n.doneWhen, 0, 200)
          && n.instructions is list && n.instructions.size() <= 3
          && n.pool == 'bonus' && n.level == 'easy' && n.active == true
          && n.min is int && n.min >= 1 && n.max == n.min && n.max <= 6
          && n.type == (n.max == 1 ? 'personal' : 'group')
          && n.twistCount == 0 && n.twistDone == [] && n.needsHostSetup == false
          && n.status == 'open' && n.note == '' && n.completedBy == null && n.completedAt == null
          && (n.members == [] || n.members == [me()]);
      }

      // Players may only add themselves, at the end of the list, while there is room.
      function joinQuest() {
        let o = resource.data;
        let n = request.resource.data;
        return signedIn() && changedOnly(['members'])
          && !(me() in o.members)
          && n.members == o.members.concat([me()])
          && n.members.size() <= o.max
          && o.active == true && o.status == 'open'
          && (o.pool == 'bonus' || cfg().pickingOpen == true);
      }
      // Players may only remove themselves.
      function leaveQuest() {
        let o = resource.data;
        let n = request.resource.data;
        return signedIn() && changedOnly(['members'])
          && (me() in o.members)
          && n.members.size() == o.members.size() - 1
          && symDiff(n.members, o.members) == [me()].toSet()
          && o.status == 'open'
          && (o.pool == 'bonus' || cfg().pickingOpen == true);
      }
      // Any member of a full-enough team can mark it done (or undo).
      function setStatus() {
        let o = resource.data;
        let n = request.resource.data;
        return signedIn() && (me() in o.members) && o.members.size() >= o.min
          && changedOnly(['status', 'note', 'completedBy', 'completedAt'])
          && n.status in ['open', 'done']
          && n.note is string && n.note.size() <= 280;
      }
      // Each member ticks their own secret twist.
      function toggleTwist() {
        let o = resource.data;
        let n = request.resource.data;
        return signedIn() && (me() in o.members)
          && changedOnly(['twistDone'])
          && symDiff(n.twistDone, o.twistDone) == [me()].toSet();
      }
    }

    // Chats. "q_<questId>": the quest's team. "d_<uidA>_<uidB>": two players. The host can read everything.
    function canChat(chatId) {
      let p = chatId.split('_');
      return signedIn() && (
        (chatId == 'all' && isPlayer())
        || (p.size() == 2 && p[0] == 'q' && me() in get(/databases/$(database)/documents/quests/$(p[1])).data.members)
        || (p.size() == 3 && p[0] == 'd' && p[1] != p[2] && (me() == p[1] || me() == p[2]))
      );
    }
    function chatMetaOk(chatId) {
      let p = chatId.split('_');
      let d = request.resource.data;
      return d.keys().hasOnly(['members', 'lastAt', 'lastFrom', 'lastText'])
        && d.lastFrom == me() && d.lastAt == request.time
        && d.lastText is string && d.lastText.size() <= 80
        && (chatId == 'all' || p[0] == 'q' || d.members == [p[1], p[2]]);
    }
    match /chats/{chatId} {
      allow get: if isHost() || canChat(chatId);
      allow list: if isHost() || (signedIn() && me() in resource.data.members);
      allow create, update: if isHost() || (canChat(chatId) && chatMetaOk(chatId));
      allow delete: if isHost();
    }
    match /chats/{chatId}/messages/{mid} {
      allow read: if isHost() || canChat(chatId);
      allow create: if canChat(chatId)
        && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.at == request.time;
      // The host posts as "admin".
      allow create: if isHost() && request.resource.data.from == 'admin'
        && str(request.resource.data.text, 1, 500) && request.resource.data.at == request.time;
      allow delete: if isHost();
    }

    // Bring list: one doc per player, open until the deadline the host sets.
    match /requests/{uid} {
      allow read: if isHost() || (signedIn() && me() == uid);
      allow create, update: if isPlayer() && me() == uid
        && request.time < cfg().requestDeadline
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 25
        && request.resource.data.updatedAt == request.time;
      allow delete: if isHost();
    }

    // Dares: one player sets a sidequest for another. Who/status is public (for points); the text is private.
    match /dares/{id} {
      allow read: if signedIn();
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'completedAt'])
        && request.resource.data.from == me() && request.resource.data.to != me()
        && exists(/databases/$(database)/documents/players/$(request.resource.data.to))
        && request.resource.data.status == 'open' && request.resource.data.completedAt == null
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/dareText/$(id));
      allow update: if signedIn() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
        && request.resource.data.status in ['open', 'done', 'skipped'];
      allow delete: if isHost();
    }
    match /dareText/{id} {
      allow read: if isHost() || (signedIn()
        && me() in [get(/databases/$(database)/documents/dares/$(id)).data.to, get(/databases/$(database)/documents/dares/$(id)).data.from]);
      allow create: if isPlayer()
        && getAfter(/databases/$(database)/documents/dares/$(id)).data.from == me()
        && request.resource.data.keys().hasOnly(['title', 'details'])
        && str(request.resource.data.title, 2, 40) && str(request.resource.data.details, 0, 300);
      allow delete: if isHost();
    }

    // Usage stats: each visit writes its own session doc. Only the host can read them.
    match /sessions/{sid} {
      allow read, delete: if isHost();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'device', 'deviceLabel', 'startedAt', 'lastSeenAt', 'activeSec', 'questOpens', 'views'])
        && request.resource.data.uid == me()
        && request.resource.data.activeSec == 0
        && request.resource.data.startedAt == request.time && request.resource.data.lastSeenAt == request.time
        && str(request.resource.data.device, 1, 40) && str(request.resource.data.deviceLabel, 1, 40);
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'activeSec', 'questOpens', 'views'])
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.activeSec is int && request.resource.data.activeSec <= 86400
        && request.resource.data.questOpens.size() <= 100 && request.resource.data.views.size() <= 20;
    }

    // Secret twists: slot i belongs to the i-th member to join. A quest with one twist shares it.
    match /questSecrets/{qid}/slots/{slot} {
      allow read: if isHost() || canSeeSlot(qid, slot);
      allow write: if isHost();
    }
    function canSeeSlot(qid, slot) {
      let q = get(/databases/$(database)/documents/quests/$(qid)).data;
      return signedIn() && (me() in q.members) && q.members.size() >= q.min
        && (q.twistCount == 1 || (int(slot) < q.members.size() && q.members[int(slot)] == me()));
    }
  }
}
